DB_HOST=localhost
DB_PORT=5432
DB_NAME=sapi-db
DB_USER=postgres
DB_PASSWORD=
PORT=3000
BASE_URL=
# Optional writable directory for temporary invoice images; defaults to the OS temp directory
SAPI_TEMP_IMAGE_DIR=
# Optional override when LAN auto-detection selects the wrong adapter
LAN_IP=
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=0

KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=
KIOTVIET_MODE=live
# Used only when KIOTVIET_MODE=mock; defaults to this backend's /mock/kiotviet URL
KIOTVIET_MOCK_BASE_URL=
KIOTVIET_DEV_USE_ENV_CREDENTIALS=false
# Scheduler checks opt-in account schedules; it is disabled by default for every account.
KIOTVIET_SCHEDULER_TICK_MS=60000
INTEGRATION_ENCRYPTION_KEY=

# Optional ordered development providers. The backend tries _1 before _2.
GEMINI_API_KEY_1=
GEMINI_BASE_URL_1=https://generativelanguage.googleapis.com
GEMINI_API_KEY_2=
GEMINI_BASE_URL_2=
# Legacy development pair. When numbered providers exist, this pair is appended
# as the final fallback. Empty host = Google; ShopAIKey uses its HTTPS root, no /v1.
GEMINI_API_KEY=
# Personal keys default to Google and may use a separately approved custom host.
# Development key, host and provider are never returned to the frontend.
GEMINI_BASE_URL=
# Optional comma-separated additional HTTPS origins for PERSONAL connections.
# Google is always allowed. Never allow an untrusted host (SSRF protection).
GEMINI_ALLOWED_BASE_URLS=
# true = offer development credentials; a saved personal key still takes priority.
# Accounts must explicitly select and save development mode to use env credentials.
GEMINI_DEV_USE_ENV_KEY=false
GEMINI_MODEL=gemini-3.8-flash
# Used only when the primary model is temporarily unavailable or overloaded.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=120000
# Optional experiment override; unset preserves the original temperature 0.
GEMINI_TEMPERATURE=0
# compact is shorter; detailed keeps the full rule set as a schema-error fallback.
GEMINI_PROMPT_VERSION=compact
GEMINI_PROMPT_FALLBACK_ON_INVALID=true
