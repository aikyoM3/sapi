DB_HOST=localhost
DB_PORT=5432
DB_NAME=sapi-db
DB_USER=postgres
DB_PASSWORD=
PORT=3000
BASE_URL=
# Optional writable directory for temporary invoice images; defaults to the OS temp directory
SAPI_TEMP_IMAGE_DIR=
# Optional override when LAN auto-detection selects the wrong adapter
LAN_IP=
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=0

KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=
KIOTVIET_MODE=live
# Used only when KIOTVIET_MODE=mock; defaults to this backend's /mock/kiotviet URL
KIOTVIET_MOCK_BASE_URL=
KIOTVIET_DEV_USE_ENV_CREDENTIALS=false
INTEGRATION_ENCRYPTION_KEY=

GEMINI_API_KEY=
GEMINI_DEV_USE_ENV_KEY=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=120000
